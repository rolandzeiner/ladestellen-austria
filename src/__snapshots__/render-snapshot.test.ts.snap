exports[`station detail markup > hides amenities when show_amenities is off 1`] = `"<div class="detail" role="region" id="station-panel-at-1" aria-hidden="true" inert=""><div class="detail-inner"><div class="operator-line"><span class="detail-label"> Operator </span><span class="operator-name" lang="de">Testbetreiber</span></div><div class="rack-block"><div class="detail-label"> Charging points </div><div class="rack"><div class="rack-slot" role="group" aria-label="AC · 22 kW · Type 2 · Available" data-status="ok" title="AT*TST*E1 · Available"><span class="rack-dot" data-status="ok"></span><span class="power-badge" data-type="ac">AC</span><span class="rack-kw"><span class="rack-kw-num">22</span><span class="rack-kw-unit">kW</span></span><span class="rack-connector">Type 2</span></div></div></div><div class="detail-section"><div class="detail-label"> Payment </div><div class="chip-row"><span class="chip muted" title="App"><ha-icon aria-hidden="true" icon="mdi:cellphone"></ha-icon><span>App</span></span></div></div><div class="detail-section"><div class="detail-label"> Address </div><div class="detail-text" lang="de">Teststrasse 1, 1010 Wien</div></div><div class="actions"><a class="btn-primary" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&amp;query=48.2,16.37"><ha-icon icon="mdi:map-marker-radius-outline" aria-hidden="true"></ha-icon><span>Open in Maps</span></a></div></div></div>"`;

