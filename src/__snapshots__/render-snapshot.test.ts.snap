exports[`parking editor markup > asks for a sensor first 1`] = `"<div class="editor"><ha-form></ha-form><div class="field"><div class="field-label" id="station-picker-heading"> Station </div><ha-form></ha-form><div class="editor-hint editor-hint--muted"> Select a sensor first to see available stations. </div><div class="editor-hint" id="station-picker-hint"> The card shows each charging point of this station as a parking space. </div></div><ha-form></ha-form><ha-form hidden=""></ha-form><section class="editor-section"><div class="section-header" role="heading" aria-level="3">Header</div><div class="editor-hint">Header · with counter</div><ha-form></ha-form></section><section class="editor-section"><div class="section-header" role="heading" aria-level="3">Parking lot</div><div class="editor-hint">Smooth · Mixed · Medium</div><ha-form></ha-form><hr><ha-form></ha-form></section><section class="editor-section"><div class="section-header" role="heading" aria-level="3">Footer</div><div class="editor-hint">Logo in E-Control colours</div><ha-form></ha-form><div class="editor-hint">The logo and “Datenquelle: E-Control” always stay visible. The ladestellen.at terms of use require it.</div></section></div>"`;

