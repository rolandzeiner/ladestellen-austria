exports[`parking editor markup > asks for a sensor first 1`] = `"<div class="editor"><ha-form></ha-form><div class="editor-section"><div class="section-header" id="station-picker-heading" role="heading" aria-level="3"> Station </div><div class="editor-hint"> Pick one station from the sensor. The card shows that station's charging points as parking slots. </div><div class="editor-hint editor-hint--muted"> Select a sensor first to see available stations. </div></div><ha-form></ha-form><div class="editor-hint">The ladestellen.at Terms of Use require the E-Control logo (linking to e-control.at) and the 'Datenquelle: E-Control' line in the footer.</div></div>"`;

exports[`parking editor markup > falls back to the default fixed colour 1`] = `"<div class="editor"><ha-form></ha-form><div class="editor-section"><div class="section-header" id="station-picker-heading" role="heading" aria-level="3"> Station </div><div class="editor-hint"> Pick one station from the sensor. The card shows that station's charging points as parking slots. </div><div class="pin-list" role="radiogroup" aria-labelledby="station-picker-heading"><button type="button" role="radio" class="pin-row" aria-checked="false"><ha-icon aria-hidden="true" icon="mdi:radiobox-blank"></ha-icon><span class="pin-label">Erste</span><span class="pin-meta">0.42 km</span></button><button type="button" role="radio" class="pin-row" aria-checked="false"><ha-icon aria-hidden="true" icon="mdi:radiobox-blank"></ha-icon><span class="pin-label">Zweite</span><span class="pin-meta"></span></button></div></div><ha-form></ha-form><div class="editor-section"><div class="section-header" role="heading" aria-level="3"> Pick car colour </div><div class="toggle-row"><label class="color-swatch" style="--swatch-color: #1d4ed8;"><ha-icon icon="mdi:palette-swatch-variant" aria-hidden="true"></ha-icon><span class="color-swatch-hex">#1D4ED8</span><input type="color" class="color-swatch-input" aria-label="Pick car colour"></label></div></div><div class="editor-hint">The ladestellen.at Terms of Use require the E-Control logo (linking to e-control.at) and the 'Datenquelle: E-Control' line in the footer.</div></div>"`;

exports[`parking editor markup > flags a configured sensor that is gone 1`] = `"<div class="editor"><ha-form></ha-form><ha-alert alert-type="error"> Selected sensor is unavailable. Pick a different Ladestellen Austria sensor. </ha-alert><div class="editor-section"><div class="section-header" id="station-picker-heading" role="heading" aria-level="3"> Station </div><div class="editor-hint"> Pick one station from the sensor. The card shows that station's charging points as parking slots. </div><div class="editor-hint editor-hint--muted"> No stations returned yet — wait for the next refresh. </div></div><ha-form></ha-form><div class="editor-hint">The ladestellen.at Terms of Use require the E-Control logo (linking to e-control.at) and the 'Datenquelle: E-Control' line in the footer.</div></div>"`;

