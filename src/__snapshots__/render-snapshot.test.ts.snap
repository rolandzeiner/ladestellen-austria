exports[`station detail markup > renders every section and action when the station has them all 1`] = `"<div class="detail" role="region" id="station-panel-at-1" aria-hidden="true" inert=""><div class="detail-inner"><div class="operator-line"><span class="detail-label"> Operator </span><span class="operator-name" lang="de">Testbetreiber</span></div><div class="station-note"><ha-icon icon="mdi:information-outline" aria-hidden="true"></ha-icon><span>Zufahrt über den Hof</span></div><div class="rack-block"><div class="detail-label"> Charging points </div><div class="rack"><div class="rack-slot" role="group" aria-label="AC · 22 kW · Type 2 · Available" data-status="ok" title="AT*TST*E1 · Available"><span class="rack-dot" data-status="ok"></span><span class="power-badge" data-type="ac">AC</span><span class="rack-kw"><span class="rack-kw-num">22</span><span class="rack-kw-unit">kW</span></span><span class="rack-connector">Type 2</span></div><div class="rack-slot" role="group" aria-label="DC · 150 kW · CCS · Occupied" data-status="busy" title="AT*TST*E2 · Occupied"><span class="rack-dot" data-status="busy"></span><span class="power-badge" data-type="dc">DC</span><span class="rack-kw"><span class="rack-kw-num">150</span><span class="rack-kw-unit">kW</span></span><span class="rack-connector">CCS</span></div></div></div><div class="detail-section"><div class="detail-label"> Opening hours </div><div class="hours-row"><dl class="hours-lines"><div class="hours-line"><dt class="hours-day">Mo–Fr</dt><dd class="hours-time">08:00–18:00</dd></div></dl><span class="flag ok"><ha-icon aria-hidden="true" icon="mdi:clock-check-outline"></ha-icon><span>Open now</span></span></div></div><div class="detail-section"><div class="detail-label"> Payment </div><div class="chip-row"><span class="chip muted" title="App"><ha-icon aria-hidden="true" icon="mdi:cellphone"></ha-icon><span>App</span></span><span class="chip muted" title="Debit card"><ha-icon aria-hidden="true" icon="mdi:credit-card-outline"></ha-icon><span>Debit card</span></span></div></div><div class="detail-section"><div class="detail-label"> Amenities </div><div class="chip-row"><span class="chip muted" title="Green energy"><ha-icon aria-hidden="true" icon="mdi:leaf"></ha-icon><span>Green energy</span></span><span class="chip muted" title="Free parking"><ha-icon aria-hidden="true" icon="mdi:parking"></ha-icon><span>Free parking</span></span><span class="chip muted" title="Roofed parking"><ha-icon aria-hidden="true" icon="mdi:home-roof"></ha-icon><span>Roofed parking</span></span><span class="chip muted" title="Restrooms"><ha-icon aria-hidden="true" icon="mdi:toilet"></ha-icon><span>Restrooms</span></span></div></div><div class="detail-section"><div class="detail-label"> Address </div><div class="detail-text" lang="de">Teststrasse 1, 1010 Wien</div></div><div class="actions"><a class="btn-primary" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&amp;query=48.2,16.37"><ha-icon icon="mdi:map-marker-radius-outline" aria-hidden="true"></ha-icon><span>Open in Maps</span></a><a class="btn-secondary" target="_blank" rel="noopener noreferrer" href="https://example.at"><ha-icon aria-hidden="true" icon="mdi:web"></ha-icon><span>Website</span></a><a class="btn-secondary" href="tel:+431234567"><ha-icon icon="mdi:phone-outline" aria-hidden="true"></ha-icon><span>Call</span></a><a class="btn-secondary" target="_blank" rel="noopener noreferrer" href="https://example.at/tarife"><ha-icon aria-hidden="true" icon="mdi:cash-multiple"></ha-icon><span>Tariff</span></a></div></div></div>"`;
