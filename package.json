{
  "name": "ladestellen-austria-card",
  "private": true,
  "version": "0.0.0",
  "description": "Lovelace custom card for the Ladestellen Austria HA integration",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.include=src/**/*.ts --coverage.exclude=src/**/*.test.ts",
    "build:push": "./scripts/dev-push.sh --quiet"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "rolldown": "1.2.9",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
